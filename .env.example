# Binance API credentials — get from https://www.binance.com/en/my/settings/api-management
# For development, use Testnet keys: https://testnet.binance.vision/
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Set to "true" to route all orders to Binance Testnet
BINANCE_TESTNET=true

# Trading config
BASE_QUOTE=USDT
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=1m

# Risk limits
MAX_POSITION_USDT=100
MAX_DAILY_LOSS_USDT=20
